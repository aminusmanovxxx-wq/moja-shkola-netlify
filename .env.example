# Cloudflare Workers AI free allocation (10,000 neurons per day on Workers Free).
# Get the token and account ID from the Cloudflare dashboard, then store both ONLY
# in Netlify Project configuration -> Environment variables with Functions scope.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it

# Optional protected schedule import PIN. Store only as a server-side Function variable.
SCHEDULE_ADMIN_PIN=
