# Netlify AI Gateway injects OPENAI_API_KEY and OPENAI_BASE_URL at runtime
# after a production deploy when AI Features are enabled on a supported plan.
# Set OPENAI_API_KEY yourself only when not using the built-in gateway.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Protected schedule import: store only as a Netlify server-side Function variable.
SCHEDULE_ADMIN_PIN=
