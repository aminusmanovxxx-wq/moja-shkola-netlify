# Free-tier Gemini provider: create your own key in Google AI Studio.
# Set it ONLY as a secret server-side variable in Netlify (Functions scope).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI-compatible fallback. Never put real keys into Git or public/ files.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional PIN for protected schedule import. Store on Netlify server-side only.
SCHEDULE_ADMIN_PIN=
